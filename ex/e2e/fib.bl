// First end-to-end test to actually program with the language:
//
// This program parses input from the user and outputs fib(input). 
//
// Of course, due to the limitations of the language right now, printing is not
// possible. Therefore, the only way to return output to the user is via exit
// code, which is capped at 255 due to being 8 bits.

// Helper function
fn between(x: u8, lo: u8, hi: u8): bool {
    (lo <= x) && (x <= hi)
}

// We don't have loops yet, so this is how we traverse a string
fn parse_rec(base: *u8, index: usize, sofar: u8): u8 {
    const char = base[index];
    if (char == 0) { // null-terminated, stop
        sofar
    } else if (!between(char, 48, 57)) {
        0
    } else {
        const digit = (char) - 48;
        parse_rec(base, index + 1, sofar * 10 + digit)
    }
}

// ASCII to int except only to u8
fn atoi(ptr: *u8): u8 {
    parse_rec(ptr, 0, 0)
}

fn fib(n: u8): u8 {
    if (n == 0) 1
    else if (n == 1) 1
    else fib(n - 1) + fib (n - 2)
}

fn main(argc: u8, argv: **u8): u8 {
    const input = atoi(argv[1]);
    fib(input)
}
